// RIHAI SETU — shared database schema
// Table/column names mirror 00-rihai-setu-master-context.md exactly.
// Prisma model/field names are camelCase; @@map/@map pin the physical names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  jail_superintendent
  jail_staff
  dlsa_lawyer
  viewer
}

enum ApplicationType {
  bail
  personal_bond
}

enum ApplicationStage {
  flagged
  drafted
  filed
  hearing_scheduled
  order_passed
  released
}

enum EligibilityStatus {
  eligible
  not_eligible
  excluded
}

enum EnrollmentStatus {
  enrolled
  in_progress
  completed
}

// Not named in master context; required for undertrial vs convict counts.
enum CaseStatus {
  undertrial
  convict
  acquitted
  closed
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // MFA (TOTP). Secret stored encrypted via the PII envelope scheme (lib/pii.ts).
  mfaSecretEnc String?  @map("mfa_secret_enc")
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")

  jailAccess    JailAccess[]
  notesAuthored Note[]       @relation("NoteAuthor")
  applicationsReviewed Application[] @relation("ApplicationReviewer")
  legalAidAssignments  LegalAidAssignment[] @relation("LegalAidAssignments")
  refreshSessions      RefreshSession[]

  @@map("User")
}

model Jail {
  id                 String   @id @default(cuid())
  name               String
  state              String
  district           String
  code               String   @unique
  sanctionedCapacity Int      @map("sanctioned_capacity")
  address            String?
  contactPhone       String?  @map("contact_phone")
  createdAt          DateTime @default(now()) @map("created_at")

  jailAccess JailAccess[]
  prisoners  Prisoner[]
  occupancySnapshots OccupancySnapshot[]
  ingestionBatches IngestionBatch[]

  @@map("Jail")
}

model JailAccess {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  jailId     String   @map("jail_id")
  roleAtJail Role     @map("role_at_jail")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jail Jail @relation(fields: [jailId], references: [id], onDelete: Cascade)

  @@unique([userId, jailId])
  @@index([jailId])
  @@map("JailAccess")
}

// Tier-1 PII (full_name, date_of_birth, next-of-kin, photo) is stored ONLY in the
// *_enc envelope-encrypted columns once backfill runs; the legacy plaintext columns
// remain as nullable fallbacks and are always written NULL going forward.
// name_idx is an HMAC blind index so exact-name search works without plaintext.
model Prisoner {
  id            String    @id @default(cuid())
  jailId        String    @map("jail_id")
  fullName      String?   @map("full_name")
  prisonerRegNo String    @unique @map("prisoner_reg_no")
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String
  admissionDate DateTime  @map("admission_date")
  photoUrl      String?   @map("photo_url")
  nextOfKinName  String?  @map("next_of_kin_name")
  nextOfKinPhone String?  @map("next_of_kin_phone")

  fullNameEnc      String? @map("full_name_enc")
  dateOfBirthEnc   String? @map("date_of_birth_enc")
  nextOfKinNameEnc String? @map("next_of_kin_name_enc")
  nextOfKinPhoneEnc String? @map("next_of_kin_phone_enc")
  photoUrlEnc      String? @map("photo_url_enc")
  nameIdx          String? @map("name_idx")

  // Provenance: set when the row arrived via bulk ingestion (Prompt 8).
  sourceSystem  String?  @map("source_system")
  externalRefId String?  @map("external_ref_id")

  createdAt     DateTime  @default(now()) @map("created_at")

  jail          Jail                    @relation(fields: [jailId], references: [id])
  cases         CaseRecord[]
  assessments   EligibilityAssessment[]
  applications  Application[]
  enrollments   Enrollment[]
  notes         Note[]
  dataRequests  DataRequest[]

  @@index([jailId])
  @@index([nameIdx])
  @@map("Prisoner")
}

model CaseRecord {
  id                  String     @id @default(cuid())
  prisonerId          String     @map("prisoner_id")
  cnrNumber           String?    @unique @map("cnr_number")
  caseNumber          String     @map("case_number")
  courtName           String     @map("court_name")
  offence             String
  maxSentenceYears    Int        @map("max_sentence_years")
  carriesDeathOrLife  Boolean    @map("carries_death_or_life")
  isFirstTimeOffender Boolean    @map("is_first_time_offender")
  pendingCaseCount    Int        @map("pending_case_count")
  custodyStartDate    DateTime   @map("custody_start_date")
  caseStatus          CaseStatus @map("case_status")

  // Provenance (Prompt 8): Tier-2 fields are encrypted at the volume level in prod;
  // these columns record where bulk-ingested rows came from.
  sourceSystem  String? @map("source_system")
  externalRefId String? @map("external_ref_id")

  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at")

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  @@index([prisonerId])
  @@index([caseStatus])
  @@map("CaseRecord")
}

// Append-only by design: insert a new row per computation, never update in place.
model EligibilityAssessment {
  id          String            @id @default(cuid())
  prisonerId  String            @map("prisoner_id")
  status      EligibilityStatus
  reason      String
  computedAt  DateTime          @default(now()) @map("computed_at")

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  @@index([prisonerId])
  @@map("EligibilityAssessment")
}

model Application {
  id                   String           @id @default(cuid())
  prisonerId           String           @map("prisoner_id")
  type                 ApplicationType
  stage                ApplicationStage @default(flagged)
  generatedDocumentUrl String?          @map("generated_document_url")
  filedDate            DateTime?        @map("filed_date")
  hearingDate          DateTime?        @map("hearing_date")
  orderOutcome         String?          @map("order_outcome")
  reviewedBy           String?          @map("reviewed_by")
  reviewedAt           DateTime?        @map("reviewed_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")
  stageHistory         Json             @default("{}") @map("stage_history")

  prisoner   Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)
  reviewer   User?    @relation("ApplicationReviewer", fields: [reviewedBy], references: [id])
  stallAlerts StallAlert[]
  legalAidAssignment LegalAidAssignment?
  suretyStatus       SuretyStatus?

  @@index([stage, updatedAt])
  @@index([prisonerId])
  @@map("Application")
}

model LegalAidAssignment {
  id            String   @id @default(cuid())
  applicationId String   @unique @map("application_id")
  lawyerId      String   @map("lawyer_id")
  assignedAt    DateTime @default(now()) @map("assigned_at")
  method        String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lawyer      User        @relation("LegalAidAssignments", fields: [lawyerId], references: [id])

  @@map("LegalAidAssignment")
}

model SuretyStatus {
  id             String    @id @default(cuid())
  applicationId  String    @unique @map("application_id")
  bondAmount     Float?    @map("bond_amount")
  suretyRequired Boolean   @default(false) @map("surety_required")
  suretyArranged Boolean   @default(false) @map("surety_arranged")
  arrangedAt     DateTime? @map("arranged_at")
  notes          String?
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("SuretyStatus")
}

model TrainingProgram {
  id       String @id @default(cuid())
  name     String @unique
  category String

  enrollments Enrollment[]

  @@map("TrainingProgram")
}

model Enrollment {
  id             String           @id @default(cuid())
  prisonerId     String           @map("prisoner_id")
  programId      String           @map("program_id")
  status         EnrollmentStatus @default(enrolled)
  progressPct    Int              @default(0) @map("progress_pct")
  certificateUrl String?          @map("certificate_url")
  completedAt    DateTime?        @map("completed_at")

  prisoner Prisoner        @relation(fields: [prisonerId], references: [id], onDelete: Cascade)
  program  TrainingProgram @relation(fields: [programId], references: [id])

  @@unique([prisonerId, programId])
  @@map("Enrollment")
}

model StallAlert {
  id          String   @id @default(cuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  stage       String
  daysStalled Int      @map("days_stalled")
  escalated   Boolean  @default(false)
  escalatedAt DateTime? @map("escalated_at")

  application Application? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // Upsert identity: one alert per entity per stage.
  @@unique([entityType, entityId, stage])
  @@index([escalated])
  @@map("StallAlert")
}

model Note {
  id        String   @id @default(cuid())
  prisonerId String  @map("prisoner_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)
  author   User     @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([prisonerId])
  @@map("Note")
}

model OccupancySnapshot {
  id             String   @id @default(cuid())
  jailId         String   @map("jail_id")
  date           DateTime @db.Date
  occupancy      Int
  undertrialCount Int     @map("undertrial_count")
  convictCount   Int      @map("convict_count")

  jail Jail @relation(fields: [jailId], references: [id], onDelete: Cascade)

  @@unique([jailId, date])
  @@index([date])
  @@map("OccupancySnapshot")
}

model NotificationLog {
  id                String   @id @default(cuid())
  recipientType     String   @map("recipient_type")
  recipientContact  String?  @map("recipient_contact")
  recipientUserId   String?  @map("recipient_user_id")
  channel           String
  message           String
  relatedEntityType String   @map("related_entity_type")
  relatedEntityId   String   @map("related_entity_id")
  sentAt            DateTime @default(now()) @map("sent_at")
  status            String
  isRead            Boolean  @default(false) @map("is_read")

  @@index([recipientUserId])
  @@index([relatedEntityType, relatedEntityId])
  @@map("NotificationLog")
}

// DB-backed refresh sessions (Prompt 8): rotation invalidates the old token,
// revoke-all flips every active row for the user.
model RefreshSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  jti          String    @unique
  tokenHash    String    @map("token_hash")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  rotatedFrom  String?   @map("rotated_from")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("RefreshSession")
}

// Append-only audit trail for every read/write touching Tier-1/Tier-2 fields.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?  @map("actor_id")
  actorType    String   @default("user") @map("actor_type")
  actorName    String?  @map("actor_name")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  fieldsTouched Json?   @map("fields_touched")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("AuditLog")
}

// Prompt 8 Part 1 — bulk ingestion with mandatory human reconciliation.
model IngestionBatch {
  id          String   @id @default(cuid())
  jailId      String   @map("jail_id")
  sourceSystem String  @map("source_system")
  initiatedBy String   @map("initiated_by")
  fileName    String?  @map("file_name")
  status      String   @default("pending")
  rowCount    Int      @default(0) @map("row_count")
  errorCount  Int      @default(0) @map("error_count")
  mergedCount Int      @default(0) @map("merged_count")
  rejectedCount Int    @default(0) @map("rejected_count")
  createdAt   DateTime @default(now()) @map("created_at")

  jail Jail            @relation(fields: [jailId], references: [id])
  rows IngestionRow[]

  @@index([jailId])
  @@map("IngestionBatch")
}

model IngestionRow {
  id               String   @id @default(cuid())
  batchId          String   @map("batch_id")
  rowNo            Int      @map("row_no")
  rawData          Json     @map("raw_data")
  mappedData       Json     @map("mapped_data")
  validationStatus String   @map("validation_status")
  validationErrors Json?    @map("validation_errors")
  conflictType     String?  @map("conflict_type")
  conflictWithId   String?  @map("conflict_with_id")
  resolved         Boolean  @default(false)
  resolvedAction   String?  @map("resolved_action")
  resolvedBy       String?  @map("resolved_by")
  resolvedAt       DateTime? @map("resolved_at")

  batch IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("IngestionRow")
}

// Admin-actioned correction/deletion requests (DPDP data-principal rights).
model DataRequest {
  id          String   @id @default(cuid())
  prisonerId  String   @map("prisoner_id")
  requestedBy String   @map("requested_by")
  type        String
  reason      String
  status      String   @default("pending")
  actedBy     String?  @map("acted_by")
  actedAt     DateTime? @map("acted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  prisoner Prisoner @relation(fields: [prisonerId], references: [id], onDelete: Cascade)

  @@index([prisonerId])
  @@map("DataRequest")
}
