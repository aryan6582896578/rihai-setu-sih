# RIHAI SETU — copy to .env and adjust
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rihai_setu?schema=public"
PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="generate-a-64-byte-random-base64-secret"
JWT_REFRESH_SECRET="generate-another-64-byte-random-base64-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

WEB_ORIGIN="http://localhost:5173"

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Field-level envelope encryption master key (KEK). 64-hex-char = 256-bit.
# PROD SEAM: replace with AWS KMS GenerateDataKey/Decrypt — same wire format below.
PII_MASTER_KEY="generate-a-64-hex-char-random-key"

# Python FastAPI recommender service (rank-jobs / skill catalog)
RECOMMENDER_URL="http://127.0.0.1:8000"
